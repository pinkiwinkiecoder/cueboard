# Kopieer dit bestand naar .env.local en vul in (zie README, stap "Supabase koppelen").
# Dit zijn PUBLIEKE waarden: de anon key is bedoeld voor de browser en wordt beschermd door RLS.
# Zet hier NOOIT de service-role key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=vul-hier-de-anon-key-in

# Enkel lokaal: zet op 1 om de schermen te bekijken zonder Supabase (werkt nooit in een build).
VITE_DEMO_LOGIN=0
